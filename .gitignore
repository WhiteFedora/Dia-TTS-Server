# Ignore Python cache and compiled files
*.pyc
*.pyo
*.pyd
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ignore distribution build artifacts
.dist/
dist/
build/
*.egg-info/
.eggs/

# Ignore IDE/Editor specific files
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
.project
.pydevproject
.settings/
*.code-workspace

# Ignore OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Ignore virtual environment directories
.venv/
venv/
*/.venv/
*/venv/
env/
*/env/

# Ignore sensitive environment file
.env

# Ignore user-specific or local config
config.yaml
config.yaml.bak
config.yaml.tmp

# Ignore generated output and user data directories
outputs/
reference_audio/
model_cache/
voices/
static/

# Ignore test reports/coverage
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/

# Ignore log files and temporary files
*.log
*.tmp
*.temp
*.bak
*~

# Ignore audio/media files in root (outputs should be in outputs/)
*.wav
*.mp3
*.opus
*.ogg
*.flac
*.safetensors