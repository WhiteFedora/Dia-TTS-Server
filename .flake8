[flake8]
# Flake8 configuration for Dia-TTS-Server
max-line-length = 100
extend-ignore = 
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # E501: line too long (handled by max-line-length)
    E501,
    # W503: line break before binary operator (conflicts with black)
    W503,
    # E722: do not use bare except (we handle this case-by-case)
    E722

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .ipynb_checkpoints,
    model_cache,
    outputs,
    reference_audio,
    voices,
    ui,
    static,
    .github

# Per-file ignores
per-file-ignores =
    __init__.py:F401
